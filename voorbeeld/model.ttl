PREFIX cnt:  <http://www.w3.org/2011/content#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX eli:  <http://data.europa.eu/eli/ontology#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>
PREFIX xs:   <http://www.w3.org/2001/XMLSchema>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

eli:LegalExpression  rdf:type  sh:NodeShape , rdfs:Class;
        rdfs:label      "eli:LegalExpression";
        sh:property     [ rdf:type     sh:PropertyShape;
                          rdfs:label   "dct:title";
                          sh:datatype  xsd:string;
                          sh:maxCount  1;
                          sh:nodeKind  sh:Literal;
                          sh:path      dct:title
                        ];
        sh:property     [ rdf:type     sh:PropertyShape;
                          rdfs:label   "eli:cites";
                          sh:class     eli:LegalExpression;
                          sh:path      eli:cites
                        ];
        sh:property     [ rdf:type     sh:PropertyShape;
                          rdfs:label   "eli:position";
                          sh:datatype  xsd:integer;
                          sh:maxCount  1;
                          sh:nodeKind  sh:Literal;
                          sh:path      eli:position
                        ];
        sh:property     [ rdf:type     sh:PropertyShape;
                          rdfs:label   "eli:realizes";
                          sh:maxCount  1;
                          sh:minCount  1;
                          sh:node      [ sh:xone  ( eli:LegalResource eli:LegalResourceSubdivision )
                                       ];
                          sh:path      eli:realizes
                        ];
        sh:property     [ rdf:type     sh:PropertyShape;
                          rdfs:label   "eli:number";
                          sh:datatype  xsd:string;
                          sh:maxCount  1;
                          sh:nodeKind  sh:Literal;
                          sh:path      eli:number
                        ];
        sh:property     [ rdf:type     sh:PropertyShape;
                          rdfs:label   "cnt:chars";
                          sh:datatype  xsd:string;
                          sh:maxCount  1;
                          sh:nodeKind  sh:Literal;
                          sh:path      cnt:chars
                        ];
        sh:targetClass  eli:LegalExpression .

eli:LegalResourceSubdivision
        rdf:type        sh:NodeShape , rdfs:Class;
        rdfs:label      "eli:LegalResourceSubdivision";
        sh:property     [ rdf:type     sh:PropertyShape;
                          rdfs:label   "dct:isPartOf";
                          sh:maxCount  1;
                          sh:minCount  1;
                          sh:node      [ sh:xone  ( eli:LegalResource eli:LegalResourceSubdivision )
                                       ];
                          sh:path      dct:isPartOf
                        ];
        sh:targetClass  eli:LegalResourceSubdivision .

eli:LegalResource  rdf:type  sh:NodeShape , rdfs:Class;
        rdfs:label      "eli:LegalResource";
        sh:targetClass  eli:LegalResource .
